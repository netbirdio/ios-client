[submodule "netbird-core"]
	path = netbird-core
	# TEMPORARY: points at the fork's feat/ios-login-hint, which carries the
	# login_hint support this branch's SSO login needs (ProfileAccountEmail /
	# ClearProfileAccountEmail in client/ios/NetBirdSDK). Revert to
	# https://github.com/netbirdio/netbird.git once that lands upstream, and pin
	# the submodule to an upstream commit before merging.
	url = https://github.com/evgeniyChepelev/netbird.git
	branch = feat/ios-login-hint
