<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIAppFonts</key>
	<array>
		<string>inter-variable.ttf</string>
		<string>jetbrains-mono-variable.ttf</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.netbird.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>netbird</string>
			</array>
		</dict>
	</array>
	<!-- The PKCE login flow redirects to the SDK's loopback listener over plain
	     http. When the system auth session captures that redirect instead of
	     letting the browser follow it, the app has to replay the request to hand
	     the authorization code over; ATS would otherwise block it. Scoped to
	     local networking only — no general cleartext exception. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
